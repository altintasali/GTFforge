# Per-project user files -- create from the .example templates (see README).
# input/ holds everything that belongs to your analysis (config.yaml,
# samples.csv, optional version/resource overrides), so keeping it untracked
# means each clone is a clean project and `git pull` never conflicts with your
# analysis settings.
/input/
