#!/usr/bin/env python3
"""gtfforge -- CLI front-end for the GTFforge workflow.

  init     scaffold input/config.yaml + input/samples.csv from the templates
  samples  build a sample sheet from a directory of assembly GTFs or BAMs
  run      run snakemake on a config (locally, or with a SLURM profile)

The workflow reads input/config.yaml and input/samples.csv (or --configfile);
this CLI only creates them and launches snakemake. An analysis directory does
not need to be a GTFforge checkout: `run` links workflow/ from this checkout
into it when missing, the way TEtranscripts-pipe runs are deployed.
"""
import argparse
import csv
import glob
import io
import os
import re
import shlex
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
WORKFLOW_DIR = os.path.dirname(HERE)
REPO_ROOT = os.path.dirname(WORKFLOW_DIR)

# Longest first: "x.denovo.transcripts.gtf" must lose the whole suffix.
GTF_SUFFIXES = (
    ".denovo.transcripts.gtf.gz", ".denovo.transcripts.gtf",
    ".transcripts.gtf.gz", ".transcripts.gtf", ".gtf.gz", ".gtf",
)
BAM_SUFFIXES = (".markdup.sorted.bam", ".sorted.bam", ".bam")
# GV_WT_01 -> GV_WT ; ctrl-rep2 -> ctrl ; S3_rep1 -> S3
DEFAULT_GROUP_REGEX = r"^(.+?)[_.-](?:rep|r|R)?\d+$"


def _die(msg):
    print(f"gtfforge: error: {msg}", file=sys.stderr)
    sys.exit(1)


def _version():
    try:
        with open(os.path.join(REPO_ROOT, "VERSION")) as fh:
            return fh.read().strip()
    except OSError:
        return "unknown"


# ----------------------------------------------------------------------------
def sample_name(path, suffixes):
    base = os.path.basename(path)
    for suf in suffixes:
        if base.endswith(suf):
            return base[: -len(suf)]
    return os.path.splitext(base)[0]


def group_of(sample, regex):
    m = re.match(regex, sample)
    if not m:
        return None
    return m.group("group") if "group" in m.groupdict() else m.group(1)


def build_rows(paths, kind, group_regex, strandedness):
    """Sample sheet rows for *paths*; raises ValueError on unusable names."""
    suffixes = GTF_SUFFIXES if kind == "gtf" else BAM_SUFFIXES
    rows, seen, ungrouped = [], set(), []
    for p in sorted(paths):
        s = sample_name(p, suffixes)
        if s in seen:
            raise ValueError(f"two files map to sample '{s}' (e.g. {p})")
        seen.add(s)
        g = group_of(s, group_regex)
        if g is None:
            ungrouped.append(s)
            continue
        rows.append({
            "sample": s, "group": g,
            "gtf": os.path.abspath(p) if kind == "gtf" else "",
            "bam": os.path.abspath(p) if kind == "bam" else "",
            "strandedness": strandedness,
        })
    if ungrouped:
        raise ValueError(
            f"--group-regex {group_regex!r} does not match: {', '.join(ungrouped[:10])}"
        )
    return rows


def render_csv(rows):
    out = io.StringIO()
    out.write(
        "# Generated by gtfforge samples. group = replicate group; support is\n"
        "# counted within each group, so check the groups below before running.\n"
    )
    w = csv.DictWriter(out, fieldnames=["sample", "group", "gtf", "bam", "strandedness"],
                       lineterminator="\n")
    w.writeheader()
    w.writerows(rows)
    return out.getvalue()


def cmd_samples(a):
    if bool(a.gtf_dir) == bool(a.bam_dir):
        _die("give exactly one of --gtf-dir or --bam-dir")
    kind, d = ("gtf", a.gtf_dir) if a.gtf_dir else ("bam", a.bam_dir)
    pattern = a.pattern or ("*.gtf*" if kind == "gtf" else "*.bam")
    paths = [p for p in glob.glob(os.path.join(d, pattern)) if not p.endswith(".bai")]
    if not paths:
        _die(f"no files matching {pattern!r} in {d}")
    try:
        rows = build_rows(paths, kind, a.group_regex, a.strandedness)
    except ValueError as e:
        _die(str(e))
    text = render_csv(rows)
    groups = {}
    for r in rows:
        groups[r["group"]] = groups.get(r["group"], 0) + 1
    summary = ", ".join(f"{g} ({n})" for g, n in sorted(groups.items()))
    if a.dry_run:
        sys.stdout.write(text)
    else:
        if os.path.exists(a.output) and not a.force:
            _die(f"{a.output} exists (use --force to overwrite)")
        os.makedirs(os.path.dirname(os.path.abspath(a.output)), exist_ok=True)
        with open(a.output, "w") as fh:
            fh.write(text)
        print(f"wrote {a.output}: {len(rows)} samples", file=sys.stderr)
    print(f"groups: {summary}", file=sys.stderr)
    small = [g for g, n in groups.items() if n < 2]
    if small:
        print(f"warning: groups with one sample (GTFforge needs >= 2): {', '.join(small)}",
              file=sys.stderr)


def cmd_init(a):
    os.makedirs(a.input_dir, exist_ok=True)
    for src, name in (("config.example.yaml", "config.yaml"),
                      ("samples.example.csv", "samples.csv")):
        dst = os.path.join(a.input_dir, name)
        if os.path.exists(dst) and not a.force:
            print(f"kept existing {dst}", file=sys.stderr)
            continue
        shutil.copyfile(os.path.join(REPO_ROOT, "config", src), dst)
        print(f"wrote {dst}", file=sys.stderr)


def _ensure_workflow(root):
    """Link this checkout's workflow/ into a standalone analysis directory."""
    link = os.path.join(root, "workflow")
    if os.path.exists(link):
        return
    os.symlink(WORKFLOW_DIR, link)
    print(f"linked {link} -> {WORKFLOW_DIR}", file=sys.stderr)


def snakemake_command(a):
    cmd = ["snakemake"]
    if a.config:
        cmd += ["--configfile", os.path.abspath(a.config)]
    if a.profile:
        prof = a.profile
        if prof == "slurm":
            prof = "workflow/profiles/slurm"
        cmd += ["--workflow-profile", prof]
    else:
        cmd += ["--cores", str(a.cores)]
    if a.dry_run:
        cmd.append("-n")
    if a.snakemake_args:
        cmd += shlex.split(a.snakemake_args)
    return cmd


def cmd_run(a):
    root = os.path.abspath(a.directory)
    if not a.config and not os.path.exists(os.path.join(root, "input", "config.yaml")):
        _die(f"no --config given and {root}/input/config.yaml does not exist "
             "(create it with `gtfforge init`)")
    _ensure_workflow(root)
    cmd = snakemake_command(a)
    print("+ " + " ".join(shlex.quote(c) for c in cmd), file=sys.stderr)
    sys.exit(subprocess.call(cmd, cwd=root))


def build_parser():
    p = argparse.ArgumentParser(prog="gtfforge", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"GTFforge {_version()}")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init", help="copy the config/sample-sheet templates into input/")
    pi.add_argument("--input-dir", default="input")
    pi.add_argument("--force", action="store_true")
    pi.set_defaults(func=cmd_init)

    ps = sub.add_parser("samples", help="build a sample sheet from a directory")
    ps.add_argument("--gtf-dir", help="per-sample assembly GTFs (.gtf / .gtf.gz)")
    ps.add_argument("--bam-dir", help="coordinate-sorted BAMs")
    ps.add_argument("--pattern", help="glob within the directory (default *.gtf* / *.bam)")
    ps.add_argument("--group-regex", default=DEFAULT_GROUP_REGEX,
                    help="regex on the sample name; group 1 (or (?P<group>...)) is the "
                    f"replicate group. Default {DEFAULT_GROUP_REGEX!r} strips a trailing "
                    "replicate number: GV_WT_01 -> GV_WT")
    ps.add_argument("--strandedness", default="unstranded",
                    choices=["unstranded", "forward", "reverse"])
    ps.add_argument("-o", "--output", default="input/samples.csv")
    ps.add_argument("--force", action="store_true")
    ps.add_argument("--dry-run", action="store_true", help="print the sheet instead")
    ps.set_defaults(func=cmd_samples)

    pr = sub.add_parser("run", help="run the workflow")
    pr.add_argument("--config", help="config file (default: input/config.yaml)")
    pr.add_argument("--directory", default=".", help="analysis directory (default: .)")
    pr.add_argument("--cores", type=int, default=1)
    pr.add_argument("--profile", help="'slurm' or a profile directory")
    pr.add_argument("--dry-run", action="store_true")
    pr.add_argument("--snakemake-args", help="extra arguments passed to snakemake, quoted")
    pr.set_defaults(func=cmd_run)
    return p


def main(argv=None):
    a = build_parser().parse_args(argv)
    a.func(a)


if __name__ == "__main__":
    main()
